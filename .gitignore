# ===== Archivos generados / no versionados =====

# Distribución portable: todo dist/ es salida de build y de release
# (binarios, código copiado y ZIP). Se regenera con scripts/build-portable.ps1
# y el ZIP se publica como asset de Release, nunca en el repo.
dist/
*.zip

# Descargas y archivos multimedia del usuario
/downloads/
*.mp4
*.mkv
*.webm
*.mp3
*.m4a
*.part
*.ytdl

# Caché de herramientas y temporales
/.cache/
/tmp/
*.log
/sitios-compatibles.txt

# Sistema / editor
Thumbs.db
desktop.ini
.vscode/
.idea/

# ===== ParDL PC (Electron) =====
pc/node_modules/
pc/tools/
pc/release/
pc/test/downloads/
pc/test/tags/
pc/test/*.png
pc/test/*.log
